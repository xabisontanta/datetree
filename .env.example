# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only Supabase administration key. Phase 1 does not use it.
SUPABASE_SECRET_KEY=

# Reserved for later phases; do not expose the secret key to browser code.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Reserved for later phases; all values are server-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
