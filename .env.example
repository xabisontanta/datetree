# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only Supabase administration key. Phase 1 does not use it.
SUPABASE_SECRET_KEY=

# Server-only Twilio WhatsApp delivery. Never expose these to the browser.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+00000000000
# Required JSON map of logical names to approved utility Content SIDs, e.g.
# {"BOOKING_CONFIRMED":"HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}
TWILIO_CONTENT_SID_MAP=

# Optional booking-email delivery. Auth emails still go through Supabase.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
DATE_TREE_APP_URL=http://localhost:3000
RESEND_WEBHOOK_SECRET=
DT_NOTIFICATION_WORKER_SECRET=
TWILIO_VERIFY_SERVICE_SID=
DT_WHATSAPP_VERIFY_ENABLED=false
